{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "RedxAx",
    "DumpFridge"
  ],
  "contact": {
    "issues": "https://github.com/RedxAx/Remotely/issues",
    "sources": "https://github.com/RedxAx/Remotely"
  },
  "license": "Custom License",
  "icon": "assets/remotely/Reemotely.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "redxax.oxy.remotely.Entrypoint"
      }
    ]
  },
  "mixins": [
    "mixins.remotely.json"
  ],
  "depends": {
    "minecraft": "~${minor_mc_version}",
    "fabricloader": ">=0.17.2",
    "fabric-language-kotlin": "*"
  }
